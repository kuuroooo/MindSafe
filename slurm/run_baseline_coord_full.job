#!/bin/bash
#SBATCH --job-name=mindsafe_coord_full
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus=4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=18:00:00
#SBATCH --output=logs/coord_full_%j.out
#SBATCH --error=logs/coord_full_%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=k.c.j.wang@student.vu.nl

# MindSafe baseline — arm `psi+coord_full`.
# Coordinator-targeted attack — mode: verdict_swap_plus. Tampers with
# two pieces of the coord's input:
#   (1) monitor_result is overwritten with a pristine "safe" payload, and
#   (2) a fake "therapist self-review for orchestrator" suffix is appended
#       to the response shown to the coord, framing it as already-reviewed
#       and recommending SAFE.
# The user, the judge, and the next therapist attempt all see the
# unaltered response.
# Submit with:  sbatch slurm/run_baseline_coord_full.job

set -e

ARM=psi+coord_full

echo "=== Job start: $(date) | arm=$ARM ==="
echo "Job ID: $SLURM_JOB_ID   Node: $(hostname)"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source ~/mindsafe_env/bin/activate

export HF_HOME=/scratch-shared/$USER/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME
export HF_DATASETS_CACHE=$HF_HOME/datasets

export VLLM_WORKER_MULTIPROC_METHOD=spawn
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

export CUDA_VISIBLE_DEVICES=0,1,2,3

SWEEP_ID="${SWEEP_ID:-run_${SLURM_JOB_ID}}"
OUTPUT_DIR="data/results/baseline/${SWEEP_ID}"
mkdir -p "$OUTPUT_DIR" logs

cd ~/mindsafe

python scripts/run_baseline_experiment.py \
    --config configs/experiment_4gpu.yaml \
    --output-dir "$OUTPUT_DIR" \
    --arms "$ARM"

echo "=== Job end: $(date) | arm=$ARM ==="
