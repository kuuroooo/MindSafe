#!/bin/bash
#SBATCH --job-name=mappo_reeval
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus=4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=10:00:00
#SBATCH --output=logs/reeval_%j.out
#SBATCH --error=logs/reeval_%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=k.c.j.wang@student.vu.nl

# Re-eval existing MAPPO checkpoints with the per-turn JSONL dump.
#
# By default re-evals the five evals that fired during the main run
# (ckpt_00004, ckpt_00009, ckpt_00014, ckpt_00019, ckpt_00024). Each
# eval is ~25 conversations × ~15 turns × 5 scenarios. With vLLM judge
# warm and policy reload between checkpoints, expect ~30-40 min per
# checkpoint. 5 checkpoints → ~2.5-3.5 h.
#
# Submit:
#   sbatch slurm/reeval_checkpoints.job
#
# Submit with a custom checkpoint list:
#   sbatch --export=ALL,CKPTS="ckpt_00009 ckpt_00024" slurm/reeval_checkpoints.job
#
# Submit pointing at a different run dir:
#   sbatch --export=ALL,RUN_DIR=data/results/mappo/sweep_pilot slurm/reeval_checkpoints.job

set -e

RUN_DIR="${RUN_DIR:-data/results/mappo/main}"
CKPTS="${CKPTS:-ckpt_00004 ckpt_00009 ckpt_00014 ckpt_00019 ckpt_00024}"

echo "=== reeval start: $(date) ==="
echo "Job ID: $SLURM_JOB_ID   Node: $(hostname)"
echo "Run dir: $RUN_DIR"
echo "Checkpoints: $CKPTS"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source ~/mindsafe_env/bin/activate

python -c "import peft" 2>/dev/null || pip install --quiet "peft>=0.13.0"

export HF_HOME=/scratch-shared/$USER/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME
export HF_DATASETS_CACHE=$HF_HOME/datasets

export VLLM_WORKER_MULTIPROC_METHOD=spawn
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export CUDA_VISIBLE_DEVICES=0,1,2,3
export PYTHONUNBUFFERED=1

mkdir -p logs

cd ~/mindsafe

python scripts/reeval_checkpoints.py \
    --config configs/mappo_4gpu.yaml \
    --run-dir "$RUN_DIR" \
    --checkpoints $CKPTS

echo "=== reeval end: $(date) ==="
echo "Inspect: $RUN_DIR/eval_*_turns.jsonl + $RUN_DIR/reeval_*.json"
