#!/bin/bash
#SBATCH --job-name=mindsafe_smoke
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus=4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=01:00:00
#SBATCH --output=logs/smoke_%j.out
#SBATCH --error=logs/smoke_%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=k.c.j.wang@student.vu.nl

# MindSafe smoke test — minimal end-to-end pipeline check.
# Runs 2 arms × 1 scenario × 2 conversations to confirm:
#   - vLLM judge server starts on GPUs 1-3
#   - MAS model loads on GPU 0
#   - PATIENT-psi simulator drives conversations
#   - monitor-persuasion hook fires on the cot arm
#   - turn logs and per-arm results.json are written
# Submit with:  sbatch slurm/smoke_test.job

set -e

echo "=== Smoke test start: $(date) ==="
echo "Job ID: $SLURM_JOB_ID   Node: $(hostname)"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source ~/mindsafe_env/bin/activate

export HF_HOME=/scratch-shared/$USER/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME
export HF_DATASETS_CACHE=$HF_HOME/datasets

export VLLM_WORKER_MULTIPROC_METHOD=spawn
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

export CUDA_VISIBLE_DEVICES=0,1,2,3

OUTPUT_DIR="data/results/baseline/smoke_${SLURM_JOB_ID}"
mkdir -p "$OUTPUT_DIR" logs

cd ~/mindsafe

python scripts/run_baseline_experiment.py \
    --config configs/experiment_4gpu.yaml \
    --output-dir "$OUTPUT_DIR" \
    --arms psi psi+persuade_cot \
    --scenarios ambiguous_crisis \
    --n-conversations 2

echo "=== Smoke test end: $(date) ==="
echo "Inspect: $OUTPUT_DIR/results.json"
