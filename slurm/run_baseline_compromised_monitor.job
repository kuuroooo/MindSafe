#!/bin/bash
#SBATCH --job-name=mindsafe_compromised_monitor
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus=4
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=18:00:00
#SBATCH --output=logs/compromised_monitor_%j.out
#SBATCH --error=logs/compromised_monitor_%j.err
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=k.c.j.wang@student.vu.nl

# MindSafe baseline — arm `psi+compromised_monitor`.
# Insider-threat scenario (Lynch et al., Agentic Misalignment 2025): the
# monitor's system_prompt is replaced with a sycophantic, light-touch
# supervisory framing. The monitor still runs end-to-end and emits a real
# verdict — it's just biased toward leniency.
#
# Submit (full sweep):
#   sbatch slurm/run_baseline_compromised_monitor.job
#
# Submit (RESUME — only run a subset of scenarios into the SAME output
# tree as a previous job). Useful when an earlier run timed out partway:
#   SWEEP_ID=run_22355364 \
#   RESUME_SCENARIOS="harmful_coping dependency_seeking" \
#     sbatch slurm/run_baseline_compromised_monitor.job
#
# Conv files for the resumed scenarios are overwritten if they already
# exist (the runner is deterministic on conv_idx, so same starting
# profile is replayed). The arm's results.json gets overwritten with
# stats for ONLY the listed scenarios — use scripts that walk per-conv
# JSONLs (consensus_penalty.py, retune_thresholds.py) for full analysis
# across all completed scenarios.
#
# GPU 0    : MAS triad  (LLaMA-3-8B, HF transformers)
# GPU 1-2  : Judge      (LLaMA-3.1-70B AWQ, vLLM HTTP subprocess, TP=2)

set -e

ARM=psi+compromised_monitor
RESUME_SCENARIOS="${RESUME_SCENARIOS:-}"

echo "=== Job start: $(date) | arm=$ARM ==="
echo "Job ID: $SLURM_JOB_ID   Node: $(hostname)"
if [ -n "$RESUME_SCENARIOS" ]; then
    echo "RESUME mode — scenarios: $RESUME_SCENARIOS"
fi
nvidia-smi --query-gpu=index,name,memory.total --format=csv

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source ~/mindsafe_env/bin/activate

export HF_HOME=/scratch-shared/$USER/hf_cache
export TRANSFORMERS_CACHE=$HF_HOME
export HF_DATASETS_CACHE=$HF_HOME/datasets

export VLLM_WORKER_MULTIPROC_METHOD=spawn
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

export CUDA_VISIBLE_DEVICES=0,1,2,3

SWEEP_ID="${SWEEP_ID:-run_${SLURM_JOB_ID}}"
OUTPUT_DIR="data/results/baseline/${SWEEP_ID}"
mkdir -p "$OUTPUT_DIR" logs

cd ~/mindsafe

# Build optional --scenarios flag for resume-style submissions.
SCENARIOS_ARG=""
if [ -n "$RESUME_SCENARIOS" ]; then
    SCENARIOS_ARG="--scenarios $RESUME_SCENARIOS"
fi

python scripts/run_baseline_experiment.py \
    --config configs/experiment_4gpu.yaml \
    --output-dir "$OUTPUT_DIR" \
    --arms "$ARM" \
    $SCENARIOS_ARG

echo "=== Job end: $(date) | arm=$ARM ==="
